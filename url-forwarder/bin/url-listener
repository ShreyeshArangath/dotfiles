#!/usr/bin/env python3
"""Mac-side HTTP listener that opens URLs forwarded from a remote VM.

Bound to 127.0.0.1:9999 — reachable from this machine (including via
`ssh -R 9999:127.0.0.1:9999`) but never from the LAN. Only http/https
URLs are honored to keep `open` from invoking arbitrary handlers.

Run in a terminal/tmux pane:
    url-listener
"""
import http.server
import os
import subprocess
import sys
import urllib.parse

PORT = int(os.environ.get("URL_LISTENER_PORT", "9999"))
ALLOWED_SCHEMES = {"http", "https"}


class Handler(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        url = self.rfile.read(length).decode("utf-8", errors="replace").strip()
        parsed = urllib.parse.urlparse(url)
        if parsed.scheme in ALLOWED_SCHEMES and parsed.netloc:
            print(f"opening: {url}", flush=True)
            subprocess.run(["open", "--", url], check=False)
            self._reply(200, b"ok\n")
        else:
            print(f"rejected: {url!r}", flush=True)
            self._reply(400, b"bad url\n")

    def do_GET(self):
        self._reply(200, b"url-listener alive\n")

    def _reply(self, code, body):
        self.send_response(code)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format, *args):
        sys.stderr.write(f"{self.address_string()} - {format % args}\n")


def main():
    server = http.server.HTTPServer(("127.0.0.1", PORT), Handler)
    print(f"url-listener on http://127.0.0.1:{PORT}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
